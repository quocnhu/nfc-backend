generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  fullname              String
  password              String
  avatarUrl             String?
  isEmailVerified       Boolean          @default(false)
  roleId                String
  createdBy             String?
  failedLoginCount      Int              @default(0)
  lockedUntil           DateTime?
  status                UserStatus       @default(ACTIVE)
  tokenVersion          Int              @default(0)
  expiresAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  histories             History[]
  payments              Payment[]
  createdPermissions    Permission[]     @relation("PermissionCreator")
  qrCodes               QRCode[]
  refreshTokens         RefreshToken[]
  createdRoles          Role[]           @relation("RoleCreator")
  createdSharingContent SharingContent[] @relation("SharingContentCreator")
  sharingContent        SharingContent[]
  subscriptions         Subscription[]
  creator               User?            @relation("UserCreator", fields: [createdBy], references: [id])
  createdUsers          User[]           @relation("UserCreator")
  role                  Role             @relation(fields: [roleId], references: [id])
  userPermissions       UserPermission[]
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  isActive    Boolean      @default(true)
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creator     User?        @relation("RoleCreator", fields: [createdBy], references: [id])
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  creator         User?            @relation("PermissionCreator", fields: [createdBy], references: [id])
  planPermissions PlanPermission[]
  userPermissions UserPermission[]
  roles           Role[]           @relation("PermissionToRole")
}

model UserPermission {
  id           String             @id @default(uuid())
  userId       String
  permissionId String
  type         UserPermissionType @default(GRANT)
  createdAt    DateTime           @default(now())
  permission   Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Plan {
  id              String           @id @default(uuid())
  name            String           @unique
  displayName     String
  description     String?
  price           Float            @default(0.0)
  currency        String           @default("USD")
  durationDays    Float
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  features        Json?
  payments        Payment[]
  planPermissions PlanPermission[]
  subscriptions   Subscription[]
}

model PlanPermission {
  id           String     @id @default(uuid())
  planId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  plan         Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, permissionId])
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  planId           String?
  status           SubscriptionStatus @default(TRIAL)
  startDate        DateTime           @default(now())
  endDate          DateTime
  cancelledAt      DateTime?
  isCurrent        Boolean            @default(true)
  isForceUnlimited Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  payments         Payment[]
  plan             Plan?              @relation(fields: [planId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
}

model Payment {
  id             String                @id @default(uuid())
  userId         String
  planId         String?
  subscriptionId String?
  amount         Float
  currency       String                @default("USD")
  paypalOrderId  String?               @unique
  paypalPayerId  String?
  status         PaymentStatus         @default(PENDING)
  durationDays   Int                   @default(0)
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  plan           Plan?                 @relation(fields: [planId], references: [id])
  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id])
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents  PaymentWebhookEvent[]
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String
  eventType       String
  paymentId       String?
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime?
  receivedAt      DateTime  @default(now())
  payment         Payment?  @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([processed])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String
  expiresAt DateTime
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String
  expiresAt DateTime
}

model SharingContent {
  id        String   @id @default(uuid())
  userId    String
  url       String
  itemName  String
  icon      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User?    @relation("SharingContentCreator", fields: [createdBy], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model History {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityId   String?
  entityType String?
  details    String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  timestamp DateTime @default(now())

  @@index([email, timestamp])
  @@index([ip, timestamp])
}

model Folder {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model QRCode {
  id        String   @id @default(uuid())
  userId    String
  name      String
  url       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RequestLog {
  id                 String   @id @default(uuid())
  userId             String?
  method             String
  path               String
  statusCode         Int
  isProtected        Boolean  @default(false)
  subscriptionStatus String?
  planName           String?
  responseTime       Int?
  ipAddress          String?
  userAgent          String?
  timestamp          DateTime @default(now())

  @@index([timestamp])
  @@index([path, timestamp])
  @@index([userId, timestamp])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum UserPermissionType {
  GRANT
  DENY
}
