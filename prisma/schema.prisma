generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  fullname              String
  password              String
  avatarUrl             String?
  isEmailVerified       Boolean                 @default(false)
  roleId                String
  createdBy             String?
  failedLoginCount      Int                     @default(0)
  lockedUntil           DateTime?
  status                UserStatus              @default(ACTIVE)
  userType              UserType                @default(LOCAL)
  tokenVersion          Int                     @default(0)
  expiresAt             DateTime?
  templateId            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  histories             History[]
  payments              Payment[]
  createdPermissions    Permission[]            @relation("PermissionCreator")
  qrCodes               QRCode[]
  refreshTokens         RefreshToken[]
  createdRoles          Role[]                  @relation("RoleCreator")
  createdSharingContent SharingContent[]        @relation("SharingContentCreator")
  createdNotifications  Notification[]          @relation("NotificationCreator")
  targetedNotifications Notification[]          @relation("NotificationTargetUser")
  notifications         NotificationRecipient[]
  sharingContent        SharingContent[]
  subscriptions         Subscription[]
  translations          Translation[]
  sharedBoxes           SharedBox[]
  creator               User?                   @relation("UserCreator", fields: [createdBy], references: [id])
  createdUsers          User[]                  @relation("UserCreator")
  role                  Role                    @relation(fields: [roleId], references: [id])
  template              Template?               @relation("UserSelectedTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  userPermissions       UserPermission[]
}

model Role {
  id            String         @id @default(uuid())
  name          String         @unique
  isActive      Boolean        @default(true)
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  creator       User?          @relation("RoleCreator", fields: [createdBy], references: [id])
  users         User[]
  permissions   Permission[]   @relation("PermissionToRole")
  templates     RoleTemplate[]
  notifications Notification[]
}

model Template {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  category     String?
  description  String?
  /// Frontend renderer key, e.g. "RealEstateTemplate", "VipTemplate".
  componentKey String
  thumbnailUrl String?
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  roles        RoleTemplate[]
  users        User[]         @relation("UserSelectedTemplate")
}

model RoleTemplate {
  id         String   @id @default(uuid())
  roleId     String
  templateId String
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([roleId, templateId])
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  creator         User?            @relation("PermissionCreator", fields: [createdBy], references: [id])
  planPermissions PlanPermission[]
  userPermissions UserPermission[]
  roles           Role[]           @relation("PermissionToRole")
}

model UserPermission {
  id           String             @id @default(uuid())
  userId       String
  permissionId String
  type         UserPermissionType @default(GRANT)
  createdAt    DateTime           @default(now())
  permission   Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Plan {
  id              String           @id @default(uuid())
  name            String           @unique
  displayName     String
  description     String?
  price           Float            @default(0.0)
  currency        String           @default("USD")
  durationDays    Float
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  features        Json?
  payments        Payment[]
  planPermissions PlanPermission[]
  subscriptions   Subscription[]
}

model PlanPermission {
  id           String     @id @default(uuid())
  planId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  plan         Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, permissionId])
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  planId           String?
  status           SubscriptionStatus @default(TRIAL)
  startDate        DateTime           @default(now())
  endDate          DateTime
  cancelledAt      DateTime?
  isCurrent        Boolean            @default(true)
  isForceUnlimited Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  payments         Payment[]
  plan             Plan?              @relation(fields: [planId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
}

model Payment {
  id             String                @id @default(uuid())
  userId         String
  planId         String?
  subscriptionId String?
  amount         Float
  currency       String                @default("USD")
  paypalOrderId  String?               @unique
  paypalPayerId  String?
  status         PaymentStatus         @default(PENDING)
  durationDays   Int                   @default(0)
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  plan           Plan?                 @relation(fields: [planId], references: [id])
  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id])
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents  PaymentWebhookEvent[]
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String
  eventType       String
  paymentId       String?
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime?
  receivedAt      DateTime  @default(now())
  payment         Payment?  @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([processed])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String
  expiresAt DateTime
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String
  expiresAt DateTime
}

model SharingContent {
  id        String   @id @default(uuid())
  userId    String
  url       String
  itemName  String
  icon      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User?    @relation("SharingContentCreator", fields: [createdBy], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model History {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityId   String?
  entityType String?
  details    String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  timestamp DateTime @default(now())

  @@index([email, timestamp])
  @@index([ip, timestamp])
}

model Folder {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model QRCode {
  id        String   @id @default(uuid())
  userId    String
  name      String
  url       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Translation {
  id             String   @id @default(uuid())
  userId         String
  sourceText     String
  translatedText String
  /// Pronunciation guide for the translation (pinyin / romaji / respelling).
  /// Null for languages that need none, and for rows saved before this existed.
  romanization   String?
  sourceLang     String
  targetLang     String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A learning box opened up for anonymous visitors, identified by a share token.
///
/// Deliberately separate from Translation: a Learning Box is normally just a
/// view over one's own saved rows, but a shared box must not leak that private
/// history to a stranger, so it starts empty and keeps everything written in it
/// here. Disabling a shared box therefore never touches the owner's own data.
model SharedBox {
  id         String   @id @default(uuid())
  /// Unguessable handle that appears in the share URL and the QR. Anyone
  /// holding it may read and add to the box, so it must not be sequential.
  token      String   @unique
  ownerId    String
  inputLang  String
  outputLang String
  /// Revoked links stop serving immediately without deleting what was written.
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sentences SharedSentence[]
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

/// One line in a shared box. `isOwner` distinguishes the owner's own additions
/// from a visitor's — a stranger's text is never attributed to the owner.
model SharedSentence {
  id             String    @id @default(uuid())
  boxId          String
  sourceText     String
  translatedText String
  romanization   String?
  isOwner        Boolean   @default(false)
  /// IP of the writer, for abuse investigation only — never returned by the API.
  authorIp       String?
  createdAt      DateTime  @default(now())
  box            SharedBox @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@index([boxId, createdAt])
}

model RequestLog {
  id                 String   @id @default(uuid())
  userId             String?
  method             String
  path               String
  statusCode         Int
  isProtected        Boolean  @default(false)
  subscriptionStatus String?
  planName           String?
  responseTime       Int?
  ipAddress          String?
  userAgent          String?
  timestamp          DateTime @default(now())

  @@index([timestamp])
  @@index([path, timestamp])
  @@index([userId, timestamp])
}

model Notification {
  id           String                  @id @default(uuid())
  title        String
  body         String
  audienceType NotificationAudience    @default(ALL)
  roleId       String?
  userId       String?
  sendEmail    Boolean                 @default(true)
  skippedCount Int                     @default(0)
  createdById  String?
  createdAt    DateTime                @default(now())
  role         Role?                   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  targetUser   User?                   @relation("NotificationTargetUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy    User?                   @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipients   NotificationRecipient[]

  @@index([createdAt])
  @@index([userId])
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime?
  emailSentAt    DateTime?
  emailError     String?
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum NotificationAudience {
  ALL
  ROLE
  USER
}

enum UserType {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum UserPermissionType {
  GRANT
  DENY
}
