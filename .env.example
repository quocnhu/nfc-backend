PORT=3000

POSTGRES_PRISMA_URL="postgres://user:password@host:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://user:password@host:5432/postgres?sslmode=require"

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

JWT_SECRET="your-jwt-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Frontend
FRONTEND_URL="http://localhost:3000"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="your-email@gmail.com"

# AI (required for realtime translation) — the Realtime button translates via Gemini.
# Free key, no card needed: https://aistudio.google.com/apikey
# Also enables the ultra-natural "Achernar" American English voice.
GEMINI_API_KEY="your-google-ai-api-key"
# Optional model overrides. Defaults live in src/translation/translation.service.ts
# and fall back automatically when Google retires an id or the model is overloaded.
# GEMINI_TRANSLATE_MODEL="gemini-3.8-flash"
# GEMINI_STT_MODEL="gemini-3.8-flash"
# GEMINI_TTS_MODEL="gemini-3.8-flash-tts"
# Realtime provider chain: auto = LibreTranslate → free Google → local Ollama.
# Self-host it: docker run -d --name libretranslate -p 5000:5000 libretranslate/libretranslate --load-only en,vi,fr,zh,ja,ko,es,de,th,id,ms,hi
# TRANSLATE_PROVIDER="auto"
# LIBRETRANSLATE_URL="http://localhost:5000"
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen3:4b"
